title: "AAuth + ID-JAG Hybrid Authorization" {
  shape: text
  near: top-center
  style.font-size: 24
}

sequence: "" {
  shape: sequence_diagram

  agent: "AI Agent"
  identity_provider: "Identity Provider"
  authz_server: "Authorization Server"
  user: "User"
  resource_server: "Resource Server"

  assertion_acquisition: "Assertion Acquisition" {
    agent -> identity_provider: "Authenticate Agent"
    identity_provider -> agent: "ID-JAG Assertion (JWT)" {
      style.stroke-dash: 3
    }
  }

  policy_evaluation: "Policy Evaluation" {
    agent -> authz_server: "POST /oauth/token (token-exchange)"
    authz_server -> authz_server: "Evaluate Scope Policy"
    alt5: "[policy_requires_consent]" {
      authz_server -> agent: "202 Accepted (consent_uri)" {
        style.stroke-dash: 3
      }
      user -> authz_server: "User Approves/Denies"
    }
  }

  idjag_path: "ID-JAG Path (Automated)" {
    authz_server -> authz_server: "[policy_auto_approve] Verify ID-JAG Assertion"
    authz_server."⚠️ SECURITY: Validate signature via IdP JWKS"
    authz_server -> authz_server: "[policy_auto_approve] Issue Access Token"
    authz_server -> agent: "Access Token" {
      style.stroke-dash: 3
    }
  }

  resource_access: "Resource Access" {
    agent -> resource_server: "Request + Bearer Token"
    resource_server -> agent: "Protected Resource" {
      style.stroke-dash: 3
    }
  }
}
