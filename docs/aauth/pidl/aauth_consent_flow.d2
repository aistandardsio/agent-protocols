title: "AAuth Human Consent Flow" {
  shape: text
  near: top-center
  style.font-size: 24
}

sequence: "" {
  shape: sequence_diagram

  agent: "AI Agent"
  person_server: "Person Server"
  user: "User"
  resource_server: "Resource Server"

  authorization_request: "Authorization Request" {
    agent -> person_server: "POST /aauth/authorize"
    person_server -> person_server: "Create Mission Record"
    person_server -> agent: "202 Accepted (consent_uri, status_uri)" {
      style.stroke-dash: 3
    }
  }

  human_consent: "Human Consent" {
    user -> person_server: "GET /aauth/consent/{id}"
    person_server -> user: "Consent Page (scope, mission details)" {
      style.stroke-dash: 3
    }
    user -> person_server: "POST /aauth/consent/{id} (approve/deny)"
    alt7: "[user_denies]" {
      person_server -> person_server: "Update Mission: denied"
    }
    person_server -> person_server: "[user_approves] Update Mission: approved"
    person_server -> user: "Approval Confirmation Page" {
      style.stroke-dash: 3
    }
  }

  token_issuance: "Token Issuance" {
    agent -> person_server: "GET /aauth/consent/status/{id}"
    person_server -> person_server: "[mission_approved] Generate Access Token (JWT)"
    person_server."⚠️ SECURITY: Token includes act claim with user subject"
    person_server -> agent: "Access Token (aa-auth+jwt)" {
      style.stroke-dash: 3
    }
  }

  resource_access: "Resource Access" {
    agent -> resource_server: "Request + Bearer Token"
    resource_server -> person_server: "[keys_not_cached] GET /.well-known/jwks.json"
    person_server -> resource_server: "[keys_not_cached] JWKS (public keys)" {
      style.stroke-dash: 3
    }
    resource_server -> resource_server: "Verify Token Signature + Claims"
    resource_server."⚠️ SECURITY: Validate iss, aud, exp, scope claims"
    resource_server -> agent: "Protected Resource" {
      style.stroke-dash: 3
    }
  }
}
