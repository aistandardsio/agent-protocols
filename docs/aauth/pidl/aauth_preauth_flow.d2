title: "AAuth Pre-Authorization Flow" {
  shape: text
  near: top-center
  style.font-size: 24
}

sequence: "" {
  shape: sequence_diagram

  agent: "AI Agent"
  person_server: "Person Server"
  resource_server: "Resource Server"

  authorization_request: "Authorization Request" {
    agent -> person_server: "POST /aauth/authorize"
    person_server -> person_server: "Check Pre-Authorization"
    person_server -> person_server: "[preauth_covers_scope] Generate Access Token (JWT)"
    person_server."No consent required - scope pre-authorized"
    person_server -> agent: "200 OK (access_token)" {
      style.stroke-dash: 3
    }
  }

  resource_access: "Resource Access" {
    agent -> resource_server: "Request + Bearer Token"
    resource_server -> person_server: "[keys_not_cached] GET /.well-known/jwks.json"
    person_server -> resource_server: "[keys_not_cached] JWKS" {
      style.stroke-dash: 3
    }
    resource_server -> resource_server: "Verify Token"
    resource_server -> agent: "Protected Resource" {
      style.stroke-dash: 3
    }
  }
}
